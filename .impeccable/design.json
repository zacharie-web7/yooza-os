  "components": [
    {
      "name": "Bouton principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Commande du parcours connecté avec états de survol, focus et indisponibilité.",
      "html": "<button type=\"button\" class=\"ds-btn-primary\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Importer un PDF</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 17px;font:600 13px/1.4 Roboto,sans-serif;border-radius:8px;cursor:pointer;transition:background .18s,color .18s,border-color .18s;background:var(--avis-yellow,#FFE861);color:var(--avis-ink,#1E1E1C);border:1px solid transparent;} .ds-btn-primary svg{width:19px;height:19px;flex-shrink:0;} .ds-btn-primary:hover:not(:disabled){background:#F3DA45;border-color:transparent;color:var(--avis-ink,#1E1E1C);transform:none;} .ds-btn-primary:focus-visible{outline:3px solid #746000;outline-offset:3px;} .ds-btn-primary:disabled{opacity:.48;cursor:not-allowed;} @media(prefers-reduced-motion:reduce){.ds-btn-primary{transition:none;}}"
    },
    {
      "name": "Bouton secondaire",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Commande du parcours connecté avec états de survol, focus et indisponibilité.",
      "html": "<button type=\"button\" class=\"ds-btn-secondary\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg>Vérifier le bon</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 17px;font:600 13px/1.4 Roboto,sans-serif;border-radius:8px;cursor:pointer;transition:background .18s,color .18s,border-color .18s;background:#FFFFFF;color:var(--avis-ink,#1E1E1C);border:1px solid #D6D6CB;} .ds-btn-secondary svg{width:19px;height:19px;flex-shrink:0;} .ds-btn-secondary:hover:not(:disabled){background:#F1F1E9;border-color:#B9B9AA;color:var(--avis-ink,#1E1E1C);transform:none;} .ds-btn-secondary:focus-visible{outline:3px solid #746000;outline-offset:3px;} .ds-btn-secondary:disabled{opacity:.48;cursor:not-allowed;} @media(prefers-reduced-motion:reduce){.ds-btn-secondary{transition:none;}}"
    },
    {
      "name": "Bouton discret",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Commande du parcours connecté avec états de survol, focus et indisponibilité.",
      "html": "<button type=\"button\" class=\"ds-btn-ghost\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M8 13h8M8 17h5\"/></svg>Actualiser</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 17px;font:600 13px/1.4 Roboto,sans-serif;border-radius:8px;cursor:pointer;transition:background .18s,color .18s,border-color .18s;background:transparent;color:var(--avis-ink,#1E1E1C);border:1px solid var(--avis-line,#E7E6DE);} .ds-btn-ghost svg{width:19px;height:19px;flex-shrink:0;} .ds-btn-ghost:hover:not(:disabled){background:#EEEEE6;border-color:var(--yooza-black,#1E1E1C);color:var(--avis-ink,#1E1E1C);transform:none;} .ds-btn-ghost:focus-visible{outline:3px solid #746000;outline-offset:3px;} .ds-btn-ghost:disabled{opacity:.48;cursor:not-allowed;} @media(prefers-reduced-motion:reduce){.ds-btn-ghost{transition:none;}}"
    },
    {
      "name": "Recherche de bons",
      "kind": "input",
      "description": "Recherche groupée avec son icône et un focus porté par le conteneur.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"7.5\"/><path d=\"m21 21-4.4-4.4\"/></svg><input type=\"search\" aria-label=\"Rechercher dans les bons\" placeholder=\"Rechercher un client, un bon, un travail…\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;padding:0 13px;border:1px solid #D8D8CB;border-radius:8px;background:#FFFFFF;color:var(--avis-ink,#1E1E1C);}.ds-search svg{width:17px;height:17px;flex-shrink:0;color:var(--avis-muted,#63635C);}.ds-search input{border:0;background:transparent;outline:0;font:400 13px/1.6 Roboto,sans-serif;min-height:44px;width:100%;min-width:0;color:var(--avis-ink,#1E1E1C);}.ds-search input::placeholder{color:#6C6C61;opacity:1;}.ds-search:focus-within{outline:2px solid #746000;outline-offset:2px;}"
    },
    {
      "name": "Navigation latérale",
      "kind": "nav",
      "description": "Entrée anthracite avec libellé explicite et sélection jaune.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Exemple de navigation\"><button type=\"button\" class=\"ds-nav-item ds-nav-active\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M8 13h8M8 17h5\"/></svg><span>Bons et interventions</span></button><button type=\"button\" class=\"ds-nav-item\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg><span>Réglages</span></button></nav>",
      "css": ".ds-nav{padding:14px;background:#1E1E1C;}.ds-nav-item{display:flex;align-items:center;gap:12px;width:100%;min-height:48px;padding:12px 14px;margin-bottom:6px;border:0;border-radius:8px;background:transparent;color:#C4C4B9;text-align:left;font:500 13px/1.6 Roboto,sans-serif;cursor:pointer;transition:background .18s,color .18s;}.ds-nav-item svg{width:19px;height:19px;flex-shrink:0;}.ds-nav-item:hover{background:#33332D;color:#FFFFFF;}.ds-nav-item.ds-nav-active{background:var(--avis-yellow,#FFE861);color:var(--avis-ink,#1E1E1C);font-weight:700;}.ds-nav-item:focus-visible{outline:3px solid var(--avis-yellow,#FFE861);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none;}}"
    },
